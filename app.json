{
  "expo": {
    "name": "TikTok Trainer",
    "slug": "tiktok-trainer",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "This app needs access to camera to help you record content",
        "NSMicrophoneUsageDescription": "This app needs access to microphone to record audio with your videos",
        "NSLocationWhenInUseUsageDescription": "This app uses location to provide contextual recording prompts",
        "NSPhotoLibraryUsageDescription": "This app needs access to photo library to save your recorded videos"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FFFFFF"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_IMAGES"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Allow TikTok Trainer to access your camera to help you record content."
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow TikTok Trainer to access your location to provide contextual recording prompts."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#ffffff"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "your-project-id-here"
      },
      "BACKEND_URL": "http://localhost:8000",
      "API_TIMEOUT": "30000",
      "NOTIFICATION_ENABLED": "true",
      "NOTIFICATION_SCHEDULE_HOURS": "9,18",
      "DEBUG": "true",
      "LOG_LEVEL": "debug",
      "JWT_SECRET": "",
      "API_KEY": "",
      "OPENAI_API_KEY": "",
      "GOOGLE_MAPS_API_KEY": "",
      "ANALYTICS_API_KEY": "",
      "DATABASE_URL": "",
      "REDIS_URL": "",
      "CORS_ORIGINS": "http://localhost:3000,http://localhost:19006"
    }
  }
}
