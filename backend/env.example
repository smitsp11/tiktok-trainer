# TikTok Trainer Backend Environment Variables
# Copy this file to .env in the backend directory and fill in your actual values

# Debug Configuration
DEBUG=true
LOG_LEVEL=info

# Security Configuration
JWT_SECRET=your-super-secret-jwt-key-change-in-production
API_KEY=your-api-key-here

# Database Configuration (Optional)
DATABASE_URL=postgresql://username:password@localhost:5432/tiktok_trainer
REDIS_URL=redis://localhost:6379

# CORS Configuration
CORS_ORIGINS=http://localhost:3000,http://localhost:19006

# External Services (Optional - if you add them later)
# OPENAI_API_KEY=sk-your-openai-api-key-here
# GOOGLE_MAPS_API_KEY=your-google-maps-api-key-here
# ANALYTICS_API_KEY=your-analytics-api-key-here
