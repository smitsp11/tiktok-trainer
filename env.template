# TikTok Trainer Environment Variables Template
# Copy this file to .env and fill in your actual values

# App Configuration
APP_NAME=TikTok Trainer
APP_VERSION=1.0.0
NODE_ENV=development

# Backend API Configuration (Optional)
BACKEND_URL=http://localhost:8000
API_TIMEOUT=30000

# Database Configuration (Optional - for backend)
DATABASE_URL=postgresql://username:password@localhost:5432/tiktok_trainer
REDIS_URL=redis://localhost:6379

# Security Configuration (Optional - for backend)
JWT_SECRET=your-super-secret-jwt-key-here
API_KEY=your-api-key-here

# External Services (Optional - if you add them later)
# OPENAI_API_KEY=sk-your-openai-api-key-here
# GOOGLE_MAPS_API_KEY=your-google-maps-api-key-here
# ANALYTICS_API_KEY=your-analytics-api-key-here

# Notification Configuration (Optional)
NOTIFICATION_ENABLED=true
NOTIFICATION_SCHEDULE_HOURS=9,18

# Debug Configuration
DEBUG=true
LOG_LEVEL=info
